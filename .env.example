# Copy to .env and fill in. Never commit .env.

# Which model provider to use: fake (offline, default) | ollama (local)
LLM_PROVIDER=fake

# Ollama (fully local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=600

# Currency label shown with every amount (default Rs)
# FINANCE_CURRENCY=Rs
